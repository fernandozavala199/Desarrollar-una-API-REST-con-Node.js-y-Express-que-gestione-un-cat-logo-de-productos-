                  "});",
                  "pm.test('Producto creado y se guarda su ID', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.producto).to.have.property('id');",
                  "    pm.environment.set('createdProductId', jsonData.producto.id);",
                  "});"
