    {
      "name": "02 - Catálogo y CRUD de Productos",
      "item": [
        {
          "name": "2.1 Listar Productos - Público (200 OK)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK sin necesidad de token', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contiene al menos 5 productos de ejemplo', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.productos).to.be.an('array');",
                  "    pm.expect(jsonData.productos.length).to.be.at.least(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Filtrar Productos por Categoría - Público (200 OK)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?categoria=Accesorios",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [{ "key": "categoria", "value": "Accesorios" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Todos los productos retornados pertenecen a Accesorios', function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.productos.forEach(p => {",
                  "        pm.expect(p.categoria.toLowerCase()).to.eql('accesorios');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.3 Consultar Producto por ID - Público (200 OK)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/productos/1", "host": ["{{baseUrl}}"], "path": ["productos", "1"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Producto tiene id, nombre, precio > 0', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.producto.id).to.eql(1);",
                  "    pm.expect(jsonData.producto.precio).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
