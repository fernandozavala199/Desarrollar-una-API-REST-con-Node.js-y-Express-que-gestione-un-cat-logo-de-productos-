{
  "info": {
    "_postman_id": "catalogo-api-collection-2026",
    "name": "API Catálogo de Productos y Favoritos - Zavala & Cataña",
    "description": "Colección completa de pruebas automatizadas para la API REST con Express, PostgreSQL, JWT y RBAC.\nIncluye validaciones de códigos de estado, estructura de respuestas, control de acceso por roles, persistencia y aislamiento de favoritos entre usuarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticación y Usuarios",
      "item": [
        {
          "name": "1.1 Registro Usuario A (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario A\",\n  \"correo\": \"{{userAEmail}}\",\n  \"password\": \"{{userAPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/registro", "host": ["{{baseUrl}}"], "path": ["auth", "registro"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Respuesta contiene usuario con rol \"usuario\" sin password', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('usuario');",
                  "    pm.expect(jsonData.usuario).to.have.property('id');",
                  "    pm.expect(jsonData.usuario.rol).to.eql('usuario');",
                  "    pm.expect(jsonData.usuario).to.not.have.property('password');",
                  "    pm.expect(jsonData.usuario).to.not.have.property('password_hash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Registro Usuario A - Rechazo Correo Duplicado (409 Conflict)",
