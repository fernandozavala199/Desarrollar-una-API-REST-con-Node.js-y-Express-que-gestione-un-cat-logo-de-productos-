              }
            }
          ]
        },
        {
          "name": "2.8 Actualizar Producto como Administrador (200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tablet Gráfica Profesional V2\",\n  \"descripcion\": \"Versión actualizada con conectividad Bluetooth y pantalla laminada\",\n  \"categoria\": \"Diseño\",\n  \"precio\": 279.99\n}"
            },
            "url": { "raw": "{{baseUrl}}/productos/{{createdProductId}}", "host": ["{{baseUrl}}"], "path": ["productos", "{{createdProductId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Valores actualizados correctamente', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.producto.nombre).to.eql('Tablet Gráfica Profesional V2');",
                  "    pm.expect(jsonData.producto.precio).to.eql(279.99);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
