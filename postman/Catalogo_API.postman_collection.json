          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Seguridad, Tokens y Control de Roles",
      "item": [
        {
          "name": "3.1 Crear Producto Sin Token (401 Unauthorized)",
