              }
            }
          ]
        },
        {
          "name": "3.2 Crear Producto Con Token Vencido (401 Unauthorized)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{expiredToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento Con Token Expirado\",\n  \"descripcion\": \"Token con expiración pasada\",\n  \"categoria\": \"Pruebas\",\n  \"precio\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 401 Unauthorized ante token expirado o firma inválida', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.3 Modificar Catálogo con Rol Usuario Normal (403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Intentado Por Usuario Normal\",\n  \"descripcion\": \"Debe ser rechazado porque no es admin\",\n  \"categoria\": \"Hacking\",\n  \"precio\": 99.99\n}"
            },
            "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Mensaje de error indica falta de rol de administrador', function () {",
                  "    const jsonData = pm.response.json();",
