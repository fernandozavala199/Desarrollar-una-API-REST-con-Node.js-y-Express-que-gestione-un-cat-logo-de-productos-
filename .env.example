# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_password_postgres
DB_NAME=catalogo_db

# Configuración de Autenticación JWT
JWT_SECRET=reemplazar_con_clave_secreta_segura_para_firmar_jwt
JWT_EXPIRES_IN=2h

# Credenciales para el Administrador Inicial (usadas por el script de seed/init)
ADMIN_NAME=Administrador del Sistema
ADMIN_EMAIL=admin@catalogo.com
ADMIN_PASSWORD=AdminPass123!
